# Database — SQLite path (prefix with file: for SQLite, use postgresql:// for PostgreSQL later)
DATABASE_URL=./data/tracker.db

# JWT — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying

# Bcrypt rounds — 10 is a good balance for internal apps
BCRYPT_ROUNDS=10

# Server
PORT=3000
NODE_ENV=development

# Email — weekly Monday report sent to ADMIN_EMAIL
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=jakub.pechoucek@homecredit.ph
APP_URL=https://your-app.onrender.com
