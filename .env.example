# Database — SQLite path (prefix with file: for SQLite, use postgresql:// for PostgreSQL later)
DATABASE_URL=./data/tracker.db

# JWT — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-before-deploying

# Bcrypt rounds — 10 is a good balance for internal apps
BCRYPT_ROUNDS=10

# Server
PORT=3000
NODE_ENV=development
